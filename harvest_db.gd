static func q(id: String) -> Dictionary:
	return Q.get(id, {"tags": [], "tug": 1.0, "spd": 0, "text": ""})


static func has(id: String, tag: String) -> bool:
	return (q(id)["tags"] as Array).has(tag)


## Чем режет: нож, серп, золотой серп (в руке)
static func cutter() -> String:
	for t in ["gold_sickle", "sickle", "knife"]:
		if Game.has_tool(t):
			return t
	return ""


## Можно ли вообще взять эту траву: "" — можно, иначе — чего не хватает (значок предмета)
static func missing(id: String) -> String:
	if has(id, "hot") and Game.worn("hands") != "gloves_fire":
		return "gloves_fire"
	if has(id, "shovel") and not Game.has_tool("shovel"):
		return "shovel"
	if has(id, "trowel") and not (Game.has_tool("trowel") or Game.has_tool("shovel")):
		return "trowel"
	return ""
