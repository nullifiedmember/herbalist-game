extends RefCounted
## v27: Обучение. У дома стоит девушка-гид (как гид в Террарии): рассказывает про основные механики.
## Подключается из dialog_ui.gd: start → menu, _choose → handles/handle. Она — catgirl.gd с метой "tutor".

const TEX: String = "catgirl_mira"
const NAME: String = "Мира, гид"

# темы: [id, пункт меню, текст (%s — клавиши подставляются)]
## Короткая подсказка под списком шагов (v31)
static func hint(step: int, noaxe: bool) -> String:
	var e: String = KB.key_name("interact")
	match step:
		1:
			if noaxe:
				return "Топор делается руками. Палки и камушки лежат на земле вокруг дома — иди за жёлтой стрелкой и жми %s. Потом %s: сделай топор, возьми в руку и руби дерево мышью." % [e, KB.key_name("craft")]
			return "Топор уже у тебя! Возьми его в руку (клавиша с его цифрой), подойди к дереву со стрелкой и бей мышью — упадут брёвна и саженцы."
		2:
			return "Верстак — сердце дома: мебель, удочка, инструменты. Сделай его в окне крафта (%s), возьми в руку и поставь мышью там, где удобно ходить." % KB.key_name("craft")
		3:
			return "Травы растут на полянах вокруг дома. Подойди и нажми %s: откроется окно сбора. Тяни растение вверх с корешком или срежь ножом. Новая трава запишется в книгу (%s)." % [e, KB.key_name("book")]
		4:
			return "Зелье варится в котле: налей воды, брось травы, дай согреться. Рецепт откроется сам, когда варка удастся. Не страшно, если сначала выйдет не то — пробуй сочетания."
		_:
			return "Зелья — твой заработок. К дому приходят жители с заказами: отдай им нужное зелье и получишь монеты. Можно продать и торговцу."


## Подробный рассказ Миры про текущий этап (v31)
static func stage_text(step: int, noaxe: bool) -> String:
	var e: String = KB.key_name("interact")
	var c: String = KB.key_name("craft")
	match step:
		1:
			if noaxe:
				return "Первое дело — топор, ведь без дров ничего не построить. У тебя его нет, но не беда: он делается руками из 2 палок и 2 маленьких камушков. Они лежат прямо на земле вокруг дома — жёлтая стрелка покажет ближайшие. Подойди и нажми %s, чтобы поднять. Потом открой крафт (%s) и сделай топор: он сам встанет в пояс. Возьми его в руку нужной цифрой и бей по дереву мышью. Нужно набрать 6 брёвен." % [e, c]
			return "Первое дело — дрова! Топор у тебя уже есть: возьми его в руку клавишей с его цифрой, подойди к дереву (оно отмечено стрелкой) и бей мышью. Падают брёвна, листья и саженцы — саженец можно посадить, и вырастет новое дерево. Нужно 6 брёвен: из них выйдет верстак."
		2:
			return "Теперь верстак — сердце дома. На нём делают мебель, инструменты, удочку и многое другое. Открой крафт (%s), выбери верстак за 6 брёвен — он появится в сумке как набор. Возьми его в руку и поставь мышью на участке: лучше там, где удобно ходить. Снести можно потом, вещи вернутся в сумку." % c
		3:
			return "Теперь главное — травы! Они растут вокруг дома, на полянах и в лесу. Подойди к траве и нажми %s: откроется окно сбора. Тяни растение вверх вместе с корешком или срежь ножом у земли — так оно отрастёт снова. Собранное неси в корзинку справа. Каждая новая трава запишется в книгу травника (%s), и ты узнаешь, на что она годится. Собери 3 штуки." % [e, KB.key_name("book")]
		4:
			return "Теперь зелья. В котле у дома: налей воды, брось травы и грей. Что получится — зависит от трав и от тепла воды. Когда варка удаётся, рецепт записывается в книгу (%s), и его можно повторить. Если вышла бурда — не страшно, пробуй другие сочетания. Свари любое зелье." % KB.key_name("book")
		_:
			return "Остался заработок. Готовые зелья нужны людям: к дому приходят жители с заказами — отдай им то, что просят, и получишь монеты. Ещё можно продать торговцам в деревнях. Отдай или продай хоть одно зелье, и обучение закончится — дальше мир твой: карта (%s), задания (%s), дом и мебель (%s)." % [KB.key_name("map"), KB.key_name("quests"), KB.key_name("build")]


const ABOUT: String = "Ты — травница. Живёшь на опушке: собираешь травы, грибы и ягоды, ловишь рыбу и бабочек, варишь зелья и продаёшь их жителям. На вырученное обустраиваешь дом, огород и мастерские, а потом идёшь исследовать мир: у каждого народа свои дела, звери и тайны. Спешить некуда — время идёт своим ходом, день сменяет ночь, погода меняется, надо есть, пить и спать. Давай научу основам по шагам."

