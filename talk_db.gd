## Приветствие с учётом репутации
static func greet_rep(land: String, tier: int, again: bool) -> String:
	var ld: Dictionary = REP_LAND_GREET.get(land, {})
	if ld.has(tier) and randf() < 0.6:
		return String((ld[tier] as Array).pick_random())
	if REP_GREET.has(tier) and randf() < 0.75:
		return String((REP_GREET[tier] as Array).pick_random())
	return greet(land, again)


