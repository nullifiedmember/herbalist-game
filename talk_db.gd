## Выбрать из набора так, чтобы эта же жительница не повторяла недавнее
static func fresh(pool: Array, npc: Node) -> String:
	if pool.is_empty():
		return ""
	var said: Array = []
	if npc != null and npc.has_meta("said_lines"):
		said = npc.get_meta("said_lines")
	var tries: int = 0
	var line: String = String(pool.pick_random())
	while said.has(line) and tries < 8:
		line = String(pool.pick_random())
		tries += 1
	said.append(line)
	while said.size() > 8:
		said.pop_front()
	if npc != null:
		npc.set_meta("said_lines", said)
	return line


static func pick(d: Dictionary, land: String) -> String:
	var pool: Array = (d.get("", []) as Array).duplicate()
	if d.has(land):
		pool.append_array(d[land])
		pool.append_array(d[land])   # свои фразы земли звучат чаще
	return String(pool.pick_random())


static func greet(land: String, again: bool) -> String:
	if again and randf() < 0.7:
		return String(GREET_AGAIN.pick_random())
	var h: float = Game.hour()
	if randf() < 0.35:
		if h >= 5.0 and h < 10.0:
			return String((GREET_TIME["morning"] as Array).pick_random())
		if h >= 18.0 and h < 22.0:
			return String((GREET_TIME["evening"] as Array).pick_random())
		if h >= 22.0 or h < 5.0:
			return String((GREET_TIME["night"] as Array).pick_random())
	return String((GREET.get(land if land != "" else "wild", GREET[""]) as Array).pick_random())


## Ответ с учётом того, сколько раз уже спрашивали
static func repeat(answer: String, count: int, land: String) -> String:
	if count <= 1:
		return answer
	if count == 2:
		return String(REPEAT_2.pick_random()) + answer
	if count == 3:
		return pick(REPEAT_3, land)
	return String(REPEAT_4.pick_random())


static func job_line(job: String, role: String) -> String:
	if JOB_TALK.has(job) and job != "":
		return String((JOB_TALK[job] as Array).pick_random())
	if JOB_TALK.has(role):
		return String((JOB_TALK[role] as Array).pick_random())
	return String((JOB_TALK[""] as Array).pick_random())


