## Ключ сочетания сфер
static func key_of(orbs: Array) -> String:
	var s: Array = orbs.duplicate()
	s.sort_custom(func(a, b): return ORDER.find(a) < ORDER.find(b))
	return "+".join(PackedStringArray(s))


static func spell_of(orbs: Array) -> Array:
	return SPELLS.get(key_of(orbs), [])


static func icon(el: String) -> Texture2D:
	return load("res://art/orb25_%s.png" % el)
