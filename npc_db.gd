static func land(id: String) -> Dictionary:
	return LANDS.get(id, {})


## Земля, к которой относится лист жителя
static func land_of(tex: String) -> String:
	if tex.begins_with("catgirl"):
		return "cats"
	if tex.begins_with("pony_"):
		return "ponies"
	if tex.begins_with("spider"):
		return "spider"
	if tex.begins_with("vampire") or tex.begins_with("werewolf") or tex.begins_with("hunter"):
		return "gothic"
	if tex.begins_with("knight") or tex.begins_with("squire") or tex.begins_with("adv_"):
		return "knights"
	if tex.begins_with("elf"):
		return "elves"
	if tex.begins_with("mage") or tex == "archmage":
		return "mages"
	if tex.begins_with("orc"):
		return "orcs"
	if tex.begins_with("goblin"):
		return "goblins"
	if tex.begins_with("dwarf"):
		return "dwarves"
	if tex.begins_with("kitsune"):
		return "japan"
	if tex.begins_with("fishgirl"):
		return "sea"
	if tex.begins_with("rock_"):
		return "live"
	if tex.begins_with("demon_"):
		return "hell"
	if tex.begins_with("angel_"):
		return "heaven"
	return ""


## Что говорят о своих местах отшельницы и изгои
static func wild_about(tex: String) -> String:
	if tex.begins_with("hermit"):
		return "В лесу много грибов: лисички — по утрам, светящиеся шляпки — ночью в гротах, а лунный гриб — только глубокой ночью у единорогов."
	if tex.begins_with("outcast"):
		return "Дикие края опасны только для тех, кто их не знает. Видела сапфирового зайца? Он прячется в лесу единорогов и в долине магов."
	return "Обычные места, ничего особенного."


static func person(tex: String) -> Array:
	return PEOPLE.get(tex, ["Незнакомка", "Я просто живу здесь."])


## Слух о какой-нибудь другой земле
static func gossip(not_land: String) -> String:
	var keys: Array = GOSSIP.keys()
	keys.erase(not_land)
	return String(GOSSIP[keys.pick_random()])
