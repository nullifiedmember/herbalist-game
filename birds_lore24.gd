const BIOME_RU: Dictionary = {
	0: "двор травницы", 1: "луга", 2: "паутинный лес", 3: "готические земли", 4: "рыцарские земли",
	5: "лес эльфов", 6: "долина магов", 7: "степь орков", 8: "горы дворфов", 9: "деревня кошкодевочек",
	10: "лес единорогов", 11: "гроты", 12: "берёзовая роща", 13: "тайга", 14: "осенний лес",
	15: "болото", 16: "поля", 17: "земли Восходящего Солнца", 18: "побережье", 19: "море",
}
const WHEN_RU: Dictionary = {"day": "днём", "night": "ночью", "dusk": "в сумерках"}
const PERCH_RU: Dictionary = {"ground": "на земле", "tree": "на деревьях", "water": "у воды"}


static func text(bid: String) -> String:
	return String(TEXT.get(bid, ""))


## Где живёт: три самых любимых места
static func where(d: Dictionary) -> String:
	var b: Dictionary = d.get("biomes", {})
	var keys: Array = b.keys()
	keys.sort_custom(func(x: Variant, y: Variant) -> bool: return int(b[x]) > int(b[y]))
	var out: Array = []
	for k in keys.slice(0, 3):
		out.append(String(BIOME_RU.get(int(k), "?")))
	return ", ".join(out)
