static var _last: Dictionary = {}


static func line(key: String) -> String:
	var arr: Array = L.get(key, [])
	if arr.is_empty():
		return "..."
	if arr.size() == 1:
		return String(arr[0])
	var i: int = randi() % arr.size()
	if int(_last.get(key, -1)) == i:
		i = (i + 1 + randi() % (arr.size() - 1)) % arr.size()
	_last[key] = i
	return String(arr[i])
